[Unit]
Description=mythra consistent license database backup

[Service]
Type=oneshot
User=mythra-licensing
Group=mythra-licensing
EnvironmentFile=/etc/mythra-licensing.env
ExecStart=/opt/mythra-licensing/backup.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mythra-licensing
ProtectHome=true
