[Unit]
Description=mythra licensing api and telegram bot
After=network-online.target
Wants=network-online.target

[Service]
User=mythra-licensing
Group=mythra-licensing
WorkingDirectory=/var/lib/mythra-licensing
EnvironmentFile=/etc/mythra-licensing.env
ExecStart=/opt/mythra-licensing/license-server
Restart=on-failure
RestartSec=5
StateDirectory=mythra-licensing
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
